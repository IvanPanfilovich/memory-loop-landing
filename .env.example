# Copy to `.env.local` to override the defaults baked into the app.

# Where the "Try it now" / "Log in" buttons point.
NEXT_PUBLIC_APP_URL=https://app.memoryloop.co

# Analytics. Both IDs are public: they are delivered to the browser as part of
# the client bundle. Leave them blank to disable the respective integration.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SMARTLOOK_KEY=
