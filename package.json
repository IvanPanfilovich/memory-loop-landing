{
  "name": "memory-loop-landing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true }); require('fs').rmSync('node_modules/.cache', { recursive: true, force: true });\"",
    "dev": "npm run clean && next dev -p 5000",
    "dev:clean": "npm run dev",
    "build": "npm run clean && next build",
    "build:clean": "npm run build",
    "start": "node scripts/start-standalone.js",
    "lint": "eslint .",
    "format": "prettier --write \"{app,components,lib,scripts}/**/*.{ts,tsx,js,mjs,css,json,md}\"",
    "format:check": "prettier --check \"{app,components,lib,scripts}/**/*.{ts,tsx,js,mjs,css,json,md}\""
  },
  "dependencies": {
    "lucide-react": "^0.555.0",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-ga4": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^20.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.4.32",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}
